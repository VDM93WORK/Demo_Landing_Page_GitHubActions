@page
@model IndexModel
@{
    ViewData["Title"] = "GitHub Actions Demo";
}

<section class="hero">
    <div class="hero-content">

        <span class="badge">.NET + GitHub Actions</span>

        <h1>La mia prima pipeline CI/CD</h1>

        <p>
            Una semplice landing page realizzata con ASP.NET Core
            per imparare GitHub Actions.
        </p>

        <div class="buttons">
            <a href="https://github.com/VDM93WORK/Demo_Landing_Page_GitHubActions" class="btn-primary">
                Scopri il progetto
            </a>

            <a href="https://github.com" class="btn-secondary">
                GitHub
            </a>
        </div>
        <form method="post" asp-page-handler="ShowGreeting" class="greeting-form">

            <input type="text"
                   name="name"
                   placeholder="Inserisci il tuo nome"
                   required />

            <button type="submit" class="btn greeting-button">
                Saluta
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.Greeting))
        {
            <div class="greeting-message">
                @Model.Greeting
            </div>
        }

    </div>
</section>

<section id="about" class="about">

    <h2>Il progetto</h2>

    <p>
        Questa applicazione viene utilizzata per sperimentare
        build, test e deploy automatici tramite GitHub Actions.
    </p>

</section>